# Variables de entorno ficticias para Backend (LessonForge AI)
# NO incluir credenciales ni secretos reales en este archivo

PROJECT_NAME="LessonForge AI"
ENVIRONMENT="development"
DOCS_ENABLED=true

# Configuración de Servidor
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Base de datos (Valores ficticios de demostración)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="lessonforge_user"
POSTGRES_PASSWORD="lessonforge_dummy_password"
POSTGRES_DB="lessonforge_db"
DATABASE_URL="postgresql+asyncpg://lessonforge_user:lessonforge_dummy_password@localhost:5432/lessonforge_db"

# Seguridad y Autenticación (Valores ficticios para desarrollo)
SECRET_KEY="dummy-insecure-secret-key-for-development-only-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Almacenamiento local de archivos
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Proveedor de IA (Clave ficticia)
AI_API_KEY="dummy-ai-api-key-for-testing"
AI_MODEL_NAME="gemini-1.5-flash"
